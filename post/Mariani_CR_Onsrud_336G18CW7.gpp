		zpos_f          = '<Z>5.3< >'
		ipos_f          = '<I>5.3< >'
		jpos_f          = '<J>5.3< >'
		kpos_f          = '<K>5.3< >'
		rpos_f          = '<R>5.3< >'
		spin_f          = '<S>5.3(p)< >'
		feed_f          = '<F>5.3< >'
		tcode_f         = '<T>2.0(p)< >'
		d_comp_f        = '<D>5.0(p)< >'
		q_step_f        = '<Q>5.3(*1000p)< >'
		p_delay_f       = '<P>5.3(*1000p)< >'
		h_comp_f        = '<H>5.0(p)< >'
		xpos_inc_f      = '<U>5.3< >'
